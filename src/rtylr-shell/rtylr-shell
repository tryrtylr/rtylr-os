#!/usr/bin/env python3
"""Launch the installed or source-tree Rtylr shell."""

from pathlib import Path
import sys

installed_root = Path("/opt/rtylr/shell")
source_root = Path(__file__).resolve().parent
sys.path.insert(0, str(installed_root if installed_root.is_dir() else source_root))

from rtylr_shell.app import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
